# Banco de dados.
# Em desenvolvimento, SQLite em arquivo. Em produção, troque por Postgres
# (altere também o `provider` em prisma/schema.prisma e o adaptador em
# src/lib/prisma.ts).
DATABASE_URL="file:./dev.db"

# Segredo usado no hash do código de retorno. Gere com:
#   openssl rand -hex 32
# TROCAR ESTE VALOR INVALIDA TODOS OS CÓDIGOS JÁ ENTREGUES às pessoas: os
# resultados continuam no banco, mas ninguém consegue mais reabrir os seus.
CODIGO_PEPPER=""

# Segredo que assina o cookie de sessão do painel da gestão. Gere com:
#   openssl rand -hex 32
# Obrigatório em produção.
SESSION_SECRET=""

# Senha única de acesso ao painel da gestão. Sem ela, o painel fica indisponível.
ADMIN_SENHA=""
